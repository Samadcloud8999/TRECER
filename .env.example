# Public browser configuration (anon/publishable key only, never service-role key).
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Private Vercel Functions configuration.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
ADMIN_USERNAME=ADMIN
# Set the administrator password you chose in Vercel, not in committed source.
ADMIN_PASSWORD=
# At least 32 random characters, separate from CRON_SECRET.
ADMIN_SESSION_SECRET=
